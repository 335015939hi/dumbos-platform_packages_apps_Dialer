<resources>
  <!-- Material Design 3 Shape System -->
  <!-- Defines consistent corner radii across all components -->

  <!-- Small components: Buttons, Chips, TextFields -->
  <style name="ShapeAppearance.Dialer.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">8dp</item>
  </style>

  <!-- Medium components: Cards, Dialogs, Menus -->
  <style name="ShapeAppearance.Dialer.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">12dp</item>
  </style>

  <!-- Large components: Bottom sheets, large surfaces -->
  <style name="ShapeAppearance.Dialer.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">16dp</item>
  </style>

  <!-- Extra large components: Side sheets, navigation drawers -->
  <style name="ShapeAppearance.Dialer.ExtraLargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">28dp</item>
  </style>
</resources>
