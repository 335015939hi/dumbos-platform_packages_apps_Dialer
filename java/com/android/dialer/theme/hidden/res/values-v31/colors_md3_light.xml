<resources>
  <!-- Material Design 3 Dynamic Colors (Android 12+ / API 31+) -->
  <!-- Override MD3 color tokens to use Material You dynamic colors from wallpaper -->

  <!-- Primary colors -->
  <color name="md3_primary">@android:color/system_accent1_500</color>
  <color name="md3_onPrimary">@android:color/system_accent1_0</color>
  <color name="md3_primaryContainer">@android:color/system_accent1_100</color>
  <color name="md3_onPrimaryContainer">@android:color/system_accent1_900</color>

  <!-- Secondary colors -->
  <color name="md3_secondary">@android:color/system_accent2_500</color>
  <color name="md3_onSecondary">@android:color/system_accent2_0</color>
  <color name="md3_secondaryContainer">@android:color/system_accent2_100</color>
  <color name="md3_onSecondaryContainer">@android:color/system_accent2_900</color>

  <!-- Tertiary colors -->
  <color name="md3_tertiary">@android:color/system_accent3_500</color>
  <color name="md3_onTertiary">@android:color/system_accent3_0</color>
  <color name="md3_tertiaryContainer">@android:color/system_accent3_100</color>
  <color name="md3_onTertiaryContainer">@android:color/system_accent3_900</color>

  <!-- Background and Surface -->
  <color name="md3_background">@android:color/system_neutral1_10</color>
  <color name="md3_onBackground">@android:color/system_neutral1_900</color>
  <color name="md3_surface">@android:color/system_neutral1_50</color>
  <color name="md3_onSurface">@android:color/system_neutral1_900</color>
  <color name="md3_surfaceContainer">@android:color/system_neutral1_100</color>
  <color name="md3_surfaceVariant">@android:color/system_neutral2_100</color>
  <color name="md3_onSurfaceVariant">@android:color/system_neutral2_700</color>

  <!-- Outline -->
  <color name="md3_outline">@android:color/system_neutral2_500</color>
  <color name="md3_outlineVariant">@android:color/system_neutral2_300</color>

  <!-- Custom Search Bar Background (lighter variant of primaryContainer for dynamic colors) -->
  <color name="search_bar_background">@android:color/system_accent1_50</color>

  <!-- Error colors remain static (not part of dynamic color scheme) -->
</resources>
