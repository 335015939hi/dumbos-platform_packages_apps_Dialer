<resources>
  <!-- Material Design 3 Semantic Color Tokens - Dark Theme -->

  <!-- Primary colors -->
  <color name="md3_primary">#5195EA</color> <!-- from dialer_theme_color dark -->
  <color name="md3_onPrimary">#003062</color>
  <color name="md3_primaryContainer">#174EA6</color>
  <color name="md3_onPrimaryContainer">#D2E3FC</color>

  <!-- Secondary colors -->
  <color name="md3_secondary">#5195EA</color> <!-- same as primary in dark mode -->
  <color name="md3_onSecondary">#003062</color>
  <color name="md3_secondaryContainer">#5F2E5F</color>
  <color name="md3_onSecondaryContainer">#FCE4EC</color>

  <!-- Tertiary colors -->
  <color name="md3_tertiary">#8AB4F8</color> <!-- lighter blue for dark mode -->
  <color name="md3_onTertiary">#003062</color>
  <color name="md3_tertiaryContainer">#174EA6</color>
  <color name="md3_onTertiaryContainer">#D2E3FC</color>

  <!-- Error colors -->
  <color name="md3_error">#F2B8B5</color>
  <color name="md3_onError">#601410</color>
  <color name="md3_errorContainer">#8C1D18</color>
  <color name="md3_onErrorContainer">#F9DEDC</color>

  <!-- Background and Surface -->
  <color name="md3_background">#202124</color> <!-- google_grey_900 -->
  <color name="md3_onBackground">#E8EAED</color> <!-- google_grey_200 -->
  <color name="md3_surface">#202124</color> <!-- google_grey_900 -->
  <color name="md3_onSurface">#E8EAED</color> <!-- google_grey_200 -->
  <color name="md3_surfaceContainer">#2D2E30</color> <!-- slightly lighter than surface for containers -->
  <color name="md3_surfaceVariant">#3C4043</color> <!-- google_grey_800 -->
  <color name="md3_onSurfaceVariant">#BDC1C6</color> <!-- google_grey_400 -->

  <!-- Outline -->
  <color name="md3_outline">#80868B</color> <!-- google_grey_600 -->
  <color name="md3_outlineVariant">#5F6368</color> <!-- google_grey_700 -->
</resources>
