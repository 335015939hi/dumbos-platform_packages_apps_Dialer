# Keep the annotation, classes, methods, and fields marked as UsedByReflection
-keep class com.android.dialer.common.proguard.UsedByReflection
-keep @com.android.dialer.common.proguard.UsedByReflection class *
-keepclassmembers class * {
    @com.android.dialer.common.proguard.UsedByReflection *;
}

-assumenosideeffects class com.android.dialer.common.LogUtil {
    public static void v(...);
    public static void d(...);
}
