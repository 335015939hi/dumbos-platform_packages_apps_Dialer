# These are referenced by com.google.common.util.concurrent and
# com.google.errorprone.annotations but don't exist on Android.
-dontwarn java.lang.ClassValue
-dontwarn javax.lang.model.element.Modifier

-keep public class * extends android.app.Fragment {
  public <init>();
}

-keep public class * extends android.support.v4.app.Fragment {
  public <init>();
}

# Keep BuildType classes - used via reflection (Class.forName + "Impl")
-keep class com.android.dialer.buildtype.BuildTypeAccessor { *; }
-keep class com.android.dialer.buildtype.BuildTypeAccessorImpl { *; }
-keep class com.android.dialer.buildtype.release.BuildTypeAccessorImpl { *; }

# Keep Constants classes - used via reflection (Class.forName + "Impl")
-keep class com.android.dialer.constants.Constants { *; }
-keep class com.android.dialer.constants.ConstantsImpl { *; }

# Keep Dagger-generated components
-keep class **Dagger* { *; }
-keep class **_Factory { *; }
-keep class **_MembersInjector { *; }

# Keep classes annotated with @Component, @Module, @Provides
-keep @dagger.Component class * { *; }
-keep @dagger.Module class * { *; }
-keepclassmembers class * {
    @dagger.Provides *;
}

# Keep Dagger component implementations
-keep class com.android.dialer.binary.aosp.DaggerAospDialerRootComponent { *; }
-keep class com.android.dialer.binary.aosp.DaggerAospDialerRootComponent$* { *; }

# Protobuf-lite rules - required for reflection-based field access
# All protobuf-generated message classes extend GeneratedMessageLite
-keep class * extends com.google.protobuf.GeneratedMessageLite { *; }
-keep class * extends com.google.protobuf.GeneratedMessageLite$Builder { *; }

# Keep inner classes (nested messages like CallDetailsEntries$CallDetailsEntry)
-keep class * extends com.google.protobuf.GeneratedMessageLite$* { *; }

# Keep OrBuilder interfaces used by protobuf
-keep interface * extends com.google.protobuf.MessageLiteOrBuilder { *; }

# Keep protobuf enums
-keepclassmembers class * extends com.google.protobuf.Internal$EnumLite {
    public static **[] values();
    public static ** valueOf(int);
}

# Keep OuterClass containers generated by protobuf
-keep class **OuterClass { *; }
-keep class **OuterClass$* { *; }

# gRPC rules (used with protobuf)
-keep class io.grpc.** { *; }
-dontwarn io.grpc.**
